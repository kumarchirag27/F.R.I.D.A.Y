# ═══════════════════════════════════════════════════════════
# F.R.I.D.A.Y. Environment Configuration
# Copy this file to .env and fill in your API keys
# ═══════════════════════════════════════════════════════════

# ── LLM Providers (at least one required) ─────────────────
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Get free key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Get key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── OSINT API Keys (optional but recommended) ────────────
# Get free key at: https://account.shodan.io
SHODAN_API_KEY=

# Get free key at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Get free key at: https://securitytrails.com/app/account
SECURITYTRAILS_API_KEY=

# Get key at: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# ── LiveKit Voice Pipeline ────────────────────────────────
# Default dev credentials (works with livekit-server --dev)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880
